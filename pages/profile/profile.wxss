.container {
  padding: 24rpx;
  padding-bottom: 60rpx;
}

.section {
  margin-bottom: 32rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 0 4rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.clear-btn {
  font-size: 24rpx;
  color: var(--danger);
}

.empty-history {
  text-align: center;
  padding: 48rpx;
  color: #999;
  font-size: 26rpx;
  background: #fff;
  border-radius: 12rpx;
}

/* 历史记录项 */
.history-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 10rpx;
}

.history-info {
  flex: 1;
}

.history-time {
  font-size: 26rpx;
  color: #333;
}

.history-summary {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.history-total {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--danger);
  margin-right: 16rpx;
}

.history-delete {
  font-size: 28rpx;
  color: #ccc;
  padding: 8rpx;
}

/* 信息卡片 */
.info-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 8rpx 24rpx;
  margin-bottom: 16rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: #666;
}

.info-value {
  font-size: 28rpx;
  color: #333;
}

/* 描述 */
.desc-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
}

.desc-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.8;
}

/* 免责声明 */
.disclaimer-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  border-left: 6rpx solid #ddd;
}

.disclaimer-text {
  font-size: 24rpx;
  color: #999;
  line-height: 1.8;
  margin-bottom: 12rpx;
}

.disclaimer-text:last-child {
  margin-bottom: 0;
}
