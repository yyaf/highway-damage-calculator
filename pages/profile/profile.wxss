.container {
  padding: 24rpx;
  padding-bottom: calc(100rpx + env(safe-area-inset-bottom) + 24rpx);
}

.section {
  margin-bottom: 32rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 0 4rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.clear-btn {
  font-size: 24rpx;
  color: var(--danger);
  padding: 12rpx 16rpx;
  display: inline-block;
}

.empty-history {
  text-align: center;
  padding: 48rpx;
  background: #fff;
  border-radius: 12rpx;
}

.empty-history-text {
  display: block;
  color: #999;
  font-size: 26rpx;
  margin-bottom: 12rpx;
}

.empty-history-hint {
  display: block;
  font-size: 22rpx;
  color: #bbb;
}

/* 历史记录项 */
.history-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 10rpx;
}

.history-info {
  flex: 1;
  padding: 12rpx 0;
}

.history-time {
  font-size: 26rpx;
  color: #333;
}

.history-summary {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.history-total {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--danger);
  margin-right: 16rpx;
}

.history-delete {
  font-size: 28rpx;
  color: #ccc;
  padding: 14rpx;
}

/* 信息卡片 */
.info-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 8rpx 24rpx;
  margin-bottom: 16rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: #666;
}

.info-value {
  font-size: 28rpx;
  color: #333;
}

/* 描述 */
.desc-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
}

.desc-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.8;
}

.desc-divider {
  height: 1rpx;
  background: #f0f0f0;
  margin: 20rpx 0;
}

.desc-label {
  font-size: 26rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.feature-list {
  margin-bottom: 4rpx;
}

.feature-item {
  font-size: 24rpx;
  color: #666;
  line-height: 2;
}

.desc-source-item {
  font-size: 24rpx;
  color: #666;
  line-height: 1.8;
  padding-left: 4rpx;
}

.desc-source-tag {
  display: inline-block;
  font-size: 20rpx;
  font-weight: 400;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  margin-right: 8rpx;
  vertical-align: middle;
}

.source-1998 {
  background: #e8f5e9;
  color: #2e7d32;
}

.source-1999 {
  background: #fff3e0;
  color: #e65100;
}

.source-2020 {
  background: #e3f2fd;
  color: #1565c0;
}

/* 免责声明 */
.disclaimer-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  border-left: 6rpx solid #ddd;
}

.disclaimer-text {
  font-size: 24rpx;
  color: #999;
  line-height: 1.8;
  margin-bottom: 12rpx;
}

.disclaimer-text:last-child {
  margin-bottom: 0;
}
