/* 页面根容器 — flex 列布局 */
page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  box-sizing: border-box;
  padding-bottom: calc(100rpx + env(safe-area-inset-bottom));
}

/* 页面标题 */
.page-header {
  flex-shrink: 0;
  padding: 32rpx 32rpx 20rpx;
  background: linear-gradient(180deg, #e8f2fd 0%, #f5f5f5 100%);
}

.page-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1a1a1a;
  letter-spacing: 2rpx;
}

.page-subtitle {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}

/* 搜索栏 */
.search-bar {
  flex-shrink: 0;
  padding: 16rpx 24rpx;
  background: #f5f5f5;
  position: relative;
  z-index: 200;
}

.search-input-box {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 40rpx;
  padding: 14rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  border: 2rpx solid #e8e8e8;
  transition: border-color 0.2s;
  position: relative;
  z-index: 201;
}

.search-input-hover {
  border-color: var(--primary);
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
}

.search-arrow {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: #999;
  transition: transform 0.25s;
  border-radius: 50%;
}

.search-arrow-hover {
  background: #f0f0f0;
}

.arrow-up {
  transform: rotate(180deg);
}

/* ---- 搜索浮层遮罩 ---- */
.dropdown-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.3);
  z-index: 150;
}

/* ---- 搜索浮层面板 ---- */
.dropdown-panel {
  position: fixed;
  top: 280rpx;
  left: 24rpx;
  right: 24rpx;
  max-height: 60vh;
  background: #fff;
  border-radius: 16rpx;
  z-index: 160;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.15);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.dropdown-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 24rpx;
  border-bottom: 1rpx solid var(--border);
  flex-shrink: 0;
}

.dropdown-count {
  font-size: 24rpx;
  color: #999;
}

.dropdown-close {
  font-size: 24rpx;
  color: var(--primary);
  padding: 12rpx 16rpx;
  display: inline-block;
}

.dropdown-list {
  flex: 1;
  max-height: 52vh;
}

.dropdown-empty {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 浮层列表项 */
.dropdown-item {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
  transition: background 0.15s;
}

.dropdown-item-hover {
  background: #f8f8f8;
}

.dropdown-item-info {
  flex: 1;
}

.dropdown-item-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.dropdown-item-spec {
  font-size: 22rpx;
  color: #999;
  margin-top: 2rpx;
}

.dropdown-item-price {
  font-size: 24rpx;
  color: var(--primary);
  margin-top: 4rpx;
}

.price-calc {
  color: #999;
  font-style: italic;
}

.dropdown-item-badge {
  min-width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  background: var(--primary);
  color: #fff;
  font-size: 22rpx;
  border-radius: 18rpx;
  padding: 0 10rpx;
  margin-right: 16rpx;
}

.dropdown-item-add {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  font-size: 32rpx;
  color: #fff;
  background: var(--primary);
  border-radius: 50%;
  font-weight: 300;
}

/* ---- 主内容区 ---- */
.main-content {
  flex: 1;
  min-height: 0;
}

/* 空状态 */
.empty-init {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  padding: 40rpx;
}

.empty-init-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  opacity: 0.4;
}

.empty-init-text {
  font-size: 30rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.empty-init-hint {
  font-size: 24rpx;
  color: #bbb;
}

.empty-init-desc {
  font-size: 22rpx;
  color: #bbb;
  text-align: center;
  line-height: 1.6;
  margin-top: 30rpx;
  padding: 0 32rpx;
}

/* ---- 已选清单 ---- */
.selected-section {
  padding: 16rpx 24rpx;
  padding-bottom: 32rpx;
}

/* 已选项目标题 */
.section-title-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.clear-link {
  font-size: 24rpx;
  color: var(--danger);
  font-weight: 400;
  padding: 12rpx 16rpx;
  display: inline-block;
}

/* 已选项目卡片 */
.selected-card {
  position: relative;
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  margin-bottom: 10rpx;
  background: #fff;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.selected-info {
  flex: 1;
}

.selected-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.selected-spec {
  font-size: 24rpx;
  color: #999;
  font-weight: 400;
}

.selected-unit-price {
  font-size: 24rpx;
  color: var(--primary);
  margin-top: 4rpx;
}

.selected-subtotal {
  font-size: 28rpx;
  font-weight: 600;
  color: #e67e22;
  margin-left: 16rpx;
  min-width: 100rpx;
  text-align: right;
}

.selected-delete {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 28rpx;
  color: #ccc;
  margin-left: 8rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.selected-delete-hover {
  color: var(--danger);
  background: #fff0f0;
}

/* 数量编辑 */
.selected-qty {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.qty-btn.small {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 28rpx;
  background: #f0f0f0;
  border-radius: 6rpx;
  flex-shrink: 0;
}

.qty-btn-hover {
  background: #ddd;
}

.qty-num-box {
  width: 72rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx dashed #ccc;
  border-radius: 6rpx;
  background: #fafafa;
}

.qty-num-text {
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
}

.qty-input {
  width: 72rpx;
  height: 56rpx;
  text-align: center;
  font-size: 26rpx;
  border: 2rpx solid var(--primary);
  border-radius: 6rpx;
  background: #fff;
}

/* ---- 底部合计栏（固定于底部，不悬浮） ---- */
.bottom-fixed-bar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
}

.bottom-summary {
  flex: 1;
  min-width: 0;
}

.bottom-total-line {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}

.bottom-total-label {
  font-size: 22rpx;
  color: #999;
}

.bottom-total-num {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--danger);
  letter-spacing: 1rpx;
}

.bottom-chinese-line {
  font-size: 26rpx;
  color: #333;
  font-weight: 600;
  margin-top: 2rpx;
}

.bottom-btns {
  display: flex;
  gap: 10rpx;
  flex-shrink: 0;
}

.btn-clear {
  padding: 16rpx 24rpx;
  border-radius: 36rpx;
  font-size: 24rpx;
  color: #666;
  border: 1rpx solid #ddd;
  background: #fff;
}

.btn-copy {
  padding: 16rpx 24rpx;
  border-radius: 36rpx;
  font-size: 24rpx;
  color: #fff;
  background: var(--primary);
  font-weight: 500;
}

/* ---- 文件来源标签 ---- */
.source-tag {
  display: inline-block;
  font-size: 20rpx;
  font-weight: 400;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  margin-left: 8rpx;
  vertical-align: middle;
}

.source-1998 {
  background: #e8f5e9;
  color: #2e7d32;
}

.source-1999 {
  background: #fff3e0;
  color: #e65100;
}

.source-2020 {
  background: #e3f2fd;
  color: #1565c0;
}

.source-both {
  background: #fce4ec;
  color: #c62828;
}

/* ---- 自定义单价 ---- */
.calc-price {
  color: #999;
  font-style: italic;
  padding: 12rpx 0;
}

.edit-hint {
  font-size: 20rpx;
  color: var(--primary);
  font-style: normal;
}

.calc-price-hover {
  background: #f0f5ff;
}

.price-input {
  width: 140rpx;
  height: 48rpx;
  text-align: center;
  font-size: 24rpx;
  border: 2rpx solid var(--primary);
  border-radius: 6rpx;
  background: #fff;
}

.custom-price-tag {
  font-size: 20rpx;
  color: #e67e22;
  margin-left: 6rpx;
}
