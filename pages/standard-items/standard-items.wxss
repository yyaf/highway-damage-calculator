page {
  overflow-x: hidden;
}

/* Tab 外层容器，用于定位渐变遮罩 */
.tabs-wrapper {
  position: relative;
}

.category-tabs {
  width: 100%;
  box-sizing: border-box;
  white-space: nowrap;
  background: #fff;
  padding: 0 20rpx;
  border-bottom: 1rpx solid var(--border);
}

/* 下划线指示器风格 Tab */
.category-tab {
  display: inline-block;
  padding: 22rpx 20rpx;
  border-bottom: 3rpx solid transparent;
  font-size: 26rpx;
  color: #888;
  flex-shrink: 0;
  white-space: nowrap;
  transition: color 0.2s;
}

.category-tab.active {
  color: var(--primary);
  font-weight: 500;
  border-bottom-color: var(--primary);
}

/* 右侧渐变遮罩 — 暗示可横向滚动 */
.tab-gradient-mask {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 60rpx;
  background: linear-gradient(to right, transparent, #fff);
  pointer-events: none;
  z-index: 1;
}

.item-list {
  height: calc(100vh - 280rpx - 100rpx - env(safe-area-inset-bottom));
}

/* 项目卡片 — flex 行布局，右侧放添加按钮 */
.readonly-card {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  padding: 24rpx 32rpx;
  margin: 12rpx 20rpx;
  background: #fff;
  border-radius: 12rpx;
}

.readonly-info {
  flex: 1;
  min-width: 0;
}

.readonly-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.readonly-spec {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.readonly-price {
  font-size: 26rpx;
  color: var(--primary);
  margin-top: 8rpx;
}

.price-calc {
  color: #999;
  font-style: italic;
}

/* 添加到计算器按钮 */
.add-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--primary);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 300;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.add-btn-hover {
  opacity: 0.8;
}

.add-btn.in-cart {
  background: #27ae60;
}
