.category-tabs {
  white-space: nowrap;
  background: #fff;
  padding: 12rpx 20rpx;
  border-bottom: 1rpx solid var(--border);
}

.category-tab {
  display: inline-block;
  padding: 10rpx 24rpx;
  margin-right: 12rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666;
  background: #f5f5f5;
}

.category-tab.active {
  color: #fff;
  background: var(--primary);
}

.item-list {
  height: calc(100vh - 280rpx);
}

.readonly-card {
  padding: 24rpx 32rpx;
  margin: 12rpx 20rpx;
  background: #fff;
  border-radius: 12rpx;
}

.readonly-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.readonly-spec {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.readonly-price {
  font-size: 26rpx;
  color: var(--primary);
  margin-top: 8rpx;
}

.price-calc {
  color: #999;
  font-style: italic;
}
